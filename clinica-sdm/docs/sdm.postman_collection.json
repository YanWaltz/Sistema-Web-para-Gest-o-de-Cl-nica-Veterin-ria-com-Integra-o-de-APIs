{
  "info": {
    "name": "SDM Clínica",
    "description": "Inicie os serviços e execute as requisições em ordem. Dados fictícios. Para testar ViaCEP ao vivo, após o login envie GET /api/cep/01001000 com o mesmo token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "endereco",
      "value": ""
    },
    {
      "key": "tutor",
      "value": ""
    },
    {
      "key": "especie",
      "value": ""
    },
    {
      "key": "raca",
      "value": ""
    },
    {
      "key": "vet",
      "value": ""
    },
    {
      "key": "animal",
      "value": ""
    },
    {
      "key": "chip",
      "value": ""
    },
    {
      "key": "hoje",
      "value": ""
    },
    {
      "key": "marca",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Saúde da clínica",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base}}/saude"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base}}/api/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"admin\",\n  \"senha\": \"ClinicaDemo!26\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if(pm.response.code===200) pm.collectionVariables.set('token',pm.response.json().access_token);",
              "const d = new Date();",
              "pm.collectionVariables.set('hoje',new Date(d-d.getTimezoneOffset()*60000).toISOString().slice(0,10));",
              "pm.collectionVariables.set('chip',Date.now().toString().padStart(15,'0'));",
              "pm.collectionVariables.set('marca',Date.now().toString().slice(-8));"
            ]
          }
        }
      ]
    },
    {
      "name": "CEP inválido",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
